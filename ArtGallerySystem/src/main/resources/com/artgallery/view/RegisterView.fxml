<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.artgallery.controller.RegisterController"
            prefWidth="600" prefHeight="500">

    <top>
        <Label text="Create Account"
               BorderPane.alignment="CENTER"
               style="-fx-font-size: 26px; -fx-font-weight: bold;">
            <BorderPane.margin>
                <Insets top="25" bottom="20"/>
            </BorderPane.margin>
        </Label>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="20">

            <GridPane alignment="CENTER" hgap="15" vgap="15">

                <Label text="Full Name:"
                       GridPane.columnIndex="0" GridPane.rowIndex="0"/>

                <TextField fx:id="fullNameField"
                           promptText="Enter full name"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Username:"
                       GridPane.columnIndex="0" GridPane.rowIndex="1"/>

                <TextField fx:id="usernameField"
                           promptText="Enter username"
                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Email:"
                       GridPane.columnIndex="0" GridPane.rowIndex="2"/>

                <TextField fx:id="emailField"
                           promptText="Enter email"
                           GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Password:"
                       GridPane.columnIndex="0" GridPane.rowIndex="3"/>

                <PasswordField fx:id="passwordField"
                               promptText="Enter password"
                               GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <Label text="Confirm Password:"
                       GridPane.columnIndex="0" GridPane.rowIndex="4"/>

                <PasswordField fx:id="confirmPasswordField"
                               promptText="Confirm password"
                               GridPane.columnIndex="1" GridPane.rowIndex="4"/>

            </GridPane>

            <CheckBox fx:id="termsCheckBox"
                      text="I agree to the gallery rules"/>

        </VBox>
    </center>

    <bottom>
        <VBox alignment="CENTER" spacing="15">

            <padding>
                <Insets top="15" right="15" bottom="25" left="15"/>
            </padding>

            <Label fx:id="messageLabel"
                   text=""
                   wrapText="true"
                   style="-fx-text-fill: red;"/>

            <HBox alignment="CENTER" spacing="15">

                <Button fx:id="backButton"
                        text="Back"
                        onAction="#handleBack"/>

                <Button fx:id="registerButton"
                        text="Register"
                        onAction="#handleRegister"/>

            </HBox>

        </VBox>
    </bottom>

</BorderPane>