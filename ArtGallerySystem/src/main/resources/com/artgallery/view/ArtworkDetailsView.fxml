<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.artgallery.controller.ArtworkDetailsController"
            prefWidth="1100" prefHeight="720">

    <!-- Top: Back button and artwork title -->
    <top>
        <HBox spacing="15" alignment="CENTER_LEFT">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>

            <Button fx:id="backButton" text="← Back" prefWidth="90"/>

            <Label fx:id="titleLabel"
                   text="Artwork Details"
                   styleClass="title"/>
        </HBox>
    </top>

    <!-- Left: Artwork image -->
    <left>
        <VBox alignment="TOP_CENTER" spacing="15" prefWidth="330">
            <padding>
                <Insets top="20" right="15" bottom="20" left="20"/>
            </padding>

            <ImageView fx:id="artworkImageView"
                       fitWidth="290"
                       fitHeight="380"
                       preserveRatio="true"
                       smooth="true"/>

        </VBox>
    </left>

    <!-- Center: Artwork information and interactions -->
    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="20" right="20" bottom="20" left="15"/>
            </padding>

            <GridPane hgap="10" vgap="12">
                <columnConstraints>
                    <ColumnConstraints minWidth="90"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Artist:"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="0"/>

                <Label fx:id="artistLabel"
                       text="-"
                       wrapText="true"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="1"/>

                <Label text="Category:"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="0"/>

                <Label fx:id="categoryLabel"
                       text="-"
                       wrapText="true"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="1"/>
                <Label text="Year:"
                        GridPane.rowIndex="2"
                        GridPane.columnIndex="0"/>

                <Label fx:id="yearLabel"
                   text="-"
                   GridPane.rowIndex="2"
                   GridPane.columnIndex="1"/>
            </GridPane>

            <Label text="Description" styleClass="section-title"/>

            <TextArea fx:id="descriptionArea"
                      editable="false"
                      wrapText="true"
                      prefRowCount="4"
                      VBox.vgrow="ALWAYS"/>

            <Separator/>

            <!-- Likes -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Button fx:id="likeButton" text="Like" prefWidth="110"/>
                <Label fx:id="likesCountLabel" text="0 likes"/>
            </HBox>

            <Separator/>

            <!-- Rating -->
            <Label text="Rate this artwork" styleClass="section-title"/>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <Slider fx:id="ratingSlider"
                        min="1" max="5"
                        value="5"
                        majorTickUnit="1"
                        minorTickCount="0"
                        snapToTicks="true"
                        showTickLabels="true"
                        showTickMarks="true"
                        prefWidth="230"/>

                <Label fx:id="ratingValueLabel" text="5 stars"/>
            </HBox>

            <Button fx:id="submitRatingButton"
                    text="Submit Rating"
                    prefWidth="140"/>

            <Label fx:id="averageRatingLabel"
                   text="Average: 0.0 / 5 (0 ratings)"/>

        </VBox>
    </center>

    <!-- Right: Comments -->
    <right>
        <VBox spacing="12" prefWidth="300">
            <padding>
                <Insets top="20" right="20" bottom="20" left="10"/>
            </padding>

            <Label text="Comments" styleClass="section-title"/>

            <ListView fx:id="commentsListView"
                      prefHeight="380"
                      VBox.vgrow="ALWAYS"/>

            <TextArea fx:id="commentArea"
                      promptText="Write your comment..."
                      wrapText="true"
                      prefRowCount="3"/>

            <HBox alignment="CENTER_RIGHT">
                <Label fx:id="charCountLabel" text="0 / 200"/>
            </HBox>

            <Button fx:id="addCommentButton"
                    text="Add Comment"
                    maxWidth="Infinity"/>

        </VBox>
    </right>

    <!-- Bottom: Feedback messages -->
    <bottom>
        <HBox alignment="CENTER_LEFT">
            <padding>
                <Insets top="10" right="20" bottom="15" left="20"/>
            </padding>

            <Label fx:id="messageLabel"
                   text=""
                   wrapText="true"/>
        </HBox>
    </bottom>

</BorderPane>
