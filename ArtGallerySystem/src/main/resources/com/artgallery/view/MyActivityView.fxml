<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.artgallery.controller.MyActivityController"
            prefWidth="1000" prefHeight="550">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="25">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Button fx:id="backButton"
                    text="Back to Gallery"
                    onAction="#handleBack"/>

            <Label fx:id="userLabel"
                   text="Activity of:"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

        </HBox>
    </top>

    <center>
        <HBox spacing="20">

            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>

            <VBox spacing="10" HBox.hgrow="ALWAYS">

                <Label text="My Comments"
                       style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                <ListView fx:id="myCommentsListView"
                          prefWidth="300"
                          VBox.vgrow="ALWAYS"/>

            </VBox>

            <VBox spacing="10" HBox.hgrow="ALWAYS">

                <Label text="Liked Artworks"
                       style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                <ListView fx:id="likedListView"
                          prefWidth="300"
                          VBox.vgrow="ALWAYS"/>

            </VBox>

            <VBox spacing="10" HBox.hgrow="ALWAYS">

                <Label text="My Ratings"
                       style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                <ListView fx:id="ratingsListView"
                          prefWidth="300"
                          VBox.vgrow="ALWAYS"/>

            </VBox>

        </HBox>
    </center>

    <bottom>
        <Label fx:id="summaryLabel"
               text="0 comments, 0 likes, 0 ratings"
               BorderPane.alignment="CENTER"
               style="-fx-font-size: 14px;">

            <BorderPane.margin>
                <Insets top="15" bottom="20"/>
            </BorderPane.margin>

        </Label>
    </bottom>

</BorderPane>