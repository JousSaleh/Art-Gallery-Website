<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.artgallery.controller.GalleryController"
            prefWidth="1000" prefHeight="680">

    <top>
        <VBox spacing="10">
            <padding><Insets top="15" right="20" bottom="10" left="20"/></padding>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label fx:id="welcomeLabel" text="Welcome" styleClass="title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="myActivityButton" text="My Activity"/>
                <Button fx:id="statisticsButton" text="Statistics"/>
                <Button fx:id="logoutButton" text="Logout"/>
            </HBox>

            <HBox spacing="15" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" promptText="Search by title or artist" prefWidth="260"/>
                <RadioButton fx:id="allRadio" text="All" selected="true">
                    <toggleGroup>
                        <ToggleGroup fx:id="categoryGroup"/>
                    </toggleGroup>
                </RadioButton>
                <RadioButton fx:id="oilRadio" text="Oil Paintings" toggleGroup="$categoryGroup"/>
                <RadioButton fx:id="pastelRadio" text="Pastel Paintings" toggleGroup="$categoryGroup"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Sort by:"/>
                <ComboBox fx:id="sortComboBox" prefWidth="160"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <FlowPane fx:id="artworkFlowPane" hgap="20" vgap="20">
                <padding><Insets top="10" right="20" bottom="20" left="20"/></padding>
            </FlowPane>
        </ScrollPane>
    </center>

    <bottom>
        <HBox>
            <padding><Insets top="8" right="20" bottom="10" left="20"/></padding>
            <Label fx:id="resultCountLabel"/>
        </HBox>
    </bottom>
</BorderPane>