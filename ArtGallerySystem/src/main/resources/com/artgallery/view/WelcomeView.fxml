<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.artgallery.controller.WelcomeController"
            prefWidth="950" prefHeight="600">

    <center>
        <VBox alignment="CENTER" spacing="20">

            <padding>
                <Insets top="40" right="40"
                        bottom="40" left="40"/>
            </padding>

            <Label text="THE ART GALLERY"
                   styleClass="title"/>

            <Label text="Discover the beauty of oil and pastel paintings."
                   wrapText="true"/>

            <Label text="Explore artworks, share your thoughts, and find inspiration."
                   wrapText="true"/>

            <HBox alignment="CENTER" spacing="15">

                <Button fx:id="loginButton"
                        text="Login"
                        prefWidth="150"
                        onAction="#handleLogin"/>

                <Button fx:id="registerButton"
                        text="Create Account"
                        prefWidth="150"
                        onAction="#handleRegister"/>

            </HBox>

            <Button fx:id="exitButton"
                    text="Exit"
                    prefWidth="120"
                    onAction="#handleExit"/>

        </VBox>
    </center>

</BorderPane>